food_items = ("Pizza", "Burger", "Sandwich", "Pasta", "Juice")

print("All Food Items:", food_items)

print("First Food:", food_items[0])

print("Last Food:", food_items[-1])

print("First 3 Food Items:", food_items[:3])

print("Is Pizza Available?", "Pizza" in food_items)

print("Pizza Count:", food_items.count("Pizza"))

print("Position of Pasta:", food_items.index("Pasta"))

