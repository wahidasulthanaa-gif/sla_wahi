employee = {
    "id": 101,
    "name": "Rahul",
    "age": 25,
    "department": "IT",
    "salary": 25000
}

print("Employee Details:", employee)

print("Name:", employee["name"])
print("Salary:", employee["salary"])

employee["experience"] = 2
print("After Adding:", employee)

employee["salary"] = 30000
print("Updated Salary:", employee)

employee.pop("age")
print("After Removing Age:", employee)

print("Keys:", employee.keys())

print("Values:", employee.values())

print("All Details:")
for key, value in employee.items():
    print(key, ":", value)

if "department" in employee:
    print("Department Available")
else:
    print("Department Not Available")
